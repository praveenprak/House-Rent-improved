# ---------- Database ----------
MONGO_URI=mongodb://localhost:27017/HouseRent
# Production: use a MongoDB Atlas connection string, e.g.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/HouseRent?retryWrites=true&w=majority

# ---------- Auth ----------
# Use a long random string in production (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=houserent_super_secret_change_me
PORT=8000

# ---------- CORS ----------
# Your deployed frontend URL(s), comma separated. Leave empty in local dev.
CLIENT_URL=

# ---------- Email (OTP verification + support replies) ----------
# Gmail example: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and paste it below (no spaces).
# If left empty in local dev, OTP codes are printed in the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=House Rent <youraddress@gmail.com>
# Optional: get an email whenever a user contacts the admin
ADMIN_NOTIFY_EMAIL=

# ---------- AI assistant (Google Gemini - free key from https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=
# Model names change over time; "gemini-flash-latest" always points to the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# ---------- Image uploads (Cloudinary free plan - https://cloudinary.com) ----------
# Required on Vercel. In local dev, if empty, images are saved to server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
